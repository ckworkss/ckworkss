<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Folder with eng.traineddata (tessdata_fast is shipped; swap for tessdata_best for accuracy). -->
    <add key="Ocr:TessDataPath" value="~/tessdata" />
    <add key="Ocr:Language" value="eng" />
    <!-- Known article codes: Code,Description,Count. Leave empty to run with grammar only. -->
    <add key="Ocr:MasterListPath" value="~/App_Data/articles.csv" />
    <!-- Semicolon separated regular expressions describing valid article codes. -->
    <add key="Ocr:ArticlePatterns" value="^[A-Z]{2}\d{6}$;^[A-Z]{2}\d{6}[A-Z]{1,2}\d{1,3}$;^[A-Z]{2}\d{6}[A-Z]{1,2}\d{1,3}-[A-Z]\d{1,2}$;^[A-Z]{1,3}\d{5,8}$" />
    <add key="Ocr:MaxImageDimension" value="2200" />
    <add key="Ocr:MinImageDimension" value="1400" />
    <add key="Ocr:RotationFallbackConfidence" value="0.35" />
    <add key="Ocr:MaxEngines" value="2" />
    <!-- Noise-model sharpness: higher = stricter matching. -->
    <add key="Ocr:Lambda" value="2.0" />
    <add key="Ocr:VerifiedThreshold" value="0.60" />
    <add key="Ocr:VerifiedMargin" value="0.25" />
    <!-- true = a code must exist in the master list before it is reported as verified. -->
    <add key="Ocr:RequireMasterListForVerification" value="false" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="20480" executionTimeout="120" />
    <pages controlRenderingCompatibilityVersion="4.0" />
    <customErrors mode="RemoteOnly" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="20971520" />
      </requestFiltering>
    </security>
    <staticContent>
      <remove fileExtension=".traineddata" />
    </staticContent>
    <!-- never serve the language data or the master list -->
    <handlers>
      <add name="BlockTessData" path="tessdata/*" verb="*" type="System.Web.HttpForbiddenHandler" />
    </handlers>
  </system.webServer>
</configuration>
