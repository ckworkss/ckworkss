<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <connectionStrings>
    <!-- Point this at your SQL Server instance. Integrated Security works when the
         IIS application pool identity has rights on the database. -->
    <add name="RemotePunch"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=RemotePunch;Integrated Security=True;MultipleActiveResultSets=False;Application Name=RemotePunch"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- ===== Time ===================================================== -->
    <!-- Windows time-zone id used to turn UTC punch times into local ones. -->
    <add key="App.TimeZoneId" value="India Standard Time" />
    <!-- Punches before this local hour count towards the previous work date
         (night shifts). 0 disables the roll-over. -->
    <add key="App.WorkDayRolloverHour" value="4" />

    <!-- ===== Geofence policy ========================================== -->
    <!-- A fix worse than this many metres is refused outright. -->
    <add key="Geo.MaxAccuracyMeters" value="150" />
    <!-- A fix worse than this is accepted but flagged as low quality. -->
    <add key="Geo.WarnAccuracyMeters" value="60" />
    <!-- Add the reported accuracy radius to the geofence radius before deciding
         "inside". Forgiving on weak GPS; set false for a strict boundary. -->
    <add key="Geo.AddAccuracyToRadius" value="true" />
    <!-- Hard cap on the bonus the line above can grant. -->
    <add key="Geo.MaxAccuracyBonusMeters" value="75" />
    <!-- Refuse a position fix older than this many seconds (stale/cached GPS). -->
    <add key="Geo.MaxPositionAgeSeconds" value="120" />
    <!-- Employees without AllowRemotePunch are refused outside every geofence.
         Set false to accept them as Flagged instead of rejecting. -->
    <add key="Geo.RejectOutsideGeofence" value="true" />

    <!-- ===== Anti-spoofing =========================================== -->
    <!-- Implied speed above this (km/h) between consecutive punches is
         physically impossible and raises a flag. -->
    <add key="Fraud.MaxImpliedSpeedKmh" value="900" />
    <!-- Two punches landing on byte-identical coordinates look synthetic. -->
    <add key="Fraud.FlagIdenticalCoordinates" value="true" />
    <!-- Flag punches from a device fingerprint an admin has not trusted. -->
    <add key="Fraud.FlagUntrustedDevice" value="true" />
    <!-- Automatically trust the first device an employee punches from. -->
    <add key="Fraud.AutoTrustFirstDevice" value="true" />
    <!-- Risk score at or above this value forces a Flagged punch. -->
    <add key="Fraud.FlagRiskThreshold" value="40" />
    <!-- Risk score at or above this value rejects the punch outright. -->
    <add key="Fraud.RejectRiskThreshold" value="100" />
    <!-- Minimum gap between two punches by the same employee, in seconds. -->
    <add key="Punch.MinIntervalSeconds" value="60" />

    <!-- ===== Selfie capture ========================================== -->
    <add key="Selfie.Enabled" value="true" />
    <!-- Force a selfie for every employee, not just RequireSelfie ones. -->
    <add key="Selfie.RequiredForAll" value="false" />
    <add key="Selfie.MaxBytes" value="1500000" />
    <add key="Selfie.StoragePath" value="~/Uploads/Selfies" />

    <!-- ===== Reverse geocoding ======================================= -->
    <!-- Provider: None | Nominatim | Google. Nominatim is the free OSM
         service - read its usage policy before enabling it in production. -->
    <add key="Geocode.Provider" value="None" />
    <add key="Geocode.GoogleApiKey" value="" />
    <add key="Geocode.TimeoutMs" value="3000" />
    <!-- Sent as the User-Agent / contact for Nominatim, which requires one. -->
    <add key="Geocode.ContactEmail" value="it@example.com" />

    <!-- ===== Diagnostics ============================================= -->
    <!-- Enables ~/Diagnostics.aspx, which explains why a sign-in is refused.
         It also requires the request to come from the server itself. Leave
         this false except while troubleshooting. -->
    <add key="Diag.Enabled" value="false" />

    <!-- ===== Login security ========================================== -->
    <add key="Auth.MaxFailedAttempts" value="5" />
    <add key="Auth.LockoutMinutes" value="15" />
  </appSettings>

  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" maxRequestLength="8192" requestValidationMode="4.5" />
    <pages enableViewStateMac="true" viewStateEncryptionMode="Always" controlRenderingCompatibilityVersion="4.0">
      <namespaces>
        <add namespace="RemotePunch.Web" />
        <add namespace="RemotePunch.Web.Core" />
        <add namespace="RemotePunch.Web.Models" />
      </namespaces>
    </pages>

    <authentication mode="Forms">
      <!-- requireSSL should be true in production; geolocation only works on
           https (or http://localhost) anyway. -->
      <forms name=".REMOTEPUNCH" loginUrl="~/Login.aspx" defaultUrl="~/Punch.aspx"
             protection="All" timeout="480" slidingExpiration="true"
             cookieless="UseCookies" requireSSL="false" />
    </authentication>

    <authorization>
      <deny users="?" />
    </authorization>

    <sessionState mode="InProc" timeout="480" cookieless="UseCookies" />
    <httpCookies httpOnlyCookies="true" requireSSL="false" sameSite="Lax" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" />
    <machineKey validation="HMACSHA256" decryption="AES" />
  </system.web>

  <!-- Anonymous access to the sign-in page and its assets only. -->
  <location path="Login.aspx">
    <system.web>
      <authorization><allow users="*" /></authorization>
    </system.web>
  </location>
  <!-- The page checks Diag.Enabled and Request.IsLocal itself, and answers
       404 when either fails; it is anonymous here so it can be used when
       nobody can sign in. -->
  <location path="Diagnostics.aspx">
    <system.web>
      <authorization><allow users="*" /></authorization>
    </system.web>
  </location>
  <location path="Error.aspx">
    <system.web>
      <authorization><allow users="*" /></authorization>
    </system.web>
  </location>
  <location path="Content">
    <system.web>
      <authorization><allow users="*" /></authorization>
    </system.web>
  </location>
  <location path="Scripts">
    <system.web>
      <authorization><allow users="*" /></authorization>
    </system.web>
  </location>

  <!-- Admin area: administrators only. Managers get the read-only reports
       that live outside this folder. -->
  <location path="Admin">
    <system.web>
      <authorization>
        <allow roles="Admin" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!-- Geolocation and camera are needed by this origin only. -->
        <add name="Permissions-Policy" value="geolocation=(self), camera=(self), microphone=()" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <!-- Punch payloads carry a base64 selfie; 8 MB is plenty. -->
        <requestLimits maxAllowedContentLength="8388608" />
      </requestFiltering>
    </security>
    <!-- Never serve stored selfies or the raw uploads folder directly. -->
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*"
           type="System.Web.Handlers.TransferRequestHandler"
           preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
