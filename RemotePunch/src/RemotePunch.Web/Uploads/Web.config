<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <!-- Stored selfies are served through Api/Selfie.ashx, which checks the
         caller's role. Direct requests into this folder are denied. -->
    <authorization>
      <deny users="*" />
    </authorization>
  </system.web>
  <system.webServer>
    <handlers>
      <clear />
    </handlers>
  </system.webServer>
</configuration>
